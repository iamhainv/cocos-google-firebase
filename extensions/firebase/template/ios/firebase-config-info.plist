<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Firebase extension — Info.plist additions merged into native/engine/ios/Info.plist by
  BuildTaskiOS.mergePlist (the engine plist's keys win on conflict). Covers FCM background
  delivery + App Tracking Transparency (shared with AdMob/Analytics).
-->
<plist version="1.0">
<dict>
    <key>UIBackgroundModes</key>
    <array>
        <string>remote-notification</string>
        <string>fetch</string>
    </array>
    <key>FirebaseAppDelegateProxyEnabled</key>
    <true/>
    <key>NSUserTrackingUsageDescription</key>
    <string>We use your data to measure and improve gameplay and to show relevant ads.</string>
</dict>
</plist>
